ARG RNG_BUILD_IMAGE=hyperbeam-rng-prod:staging
ARG HB_BASE_IMAGE

FROM ${RNG_BUILD_IMAGE} AS rng_source

FROM ${HB_BASE_IMAGE} AS preload
COPY --from=rng_source \
  /app/src/preloaded/crypto/dev_rng.erl \
  /app/src/preloaded/crypto/dev_rng_test_vectors.erl \
  /app/src/preloaded/rng/
RUN rm -rf /app/_build/preloaded-store && rebar3 device preload

FROM ${HB_BASE_IMAGE}

# Preserve the exact deployed runtime and native libraries. Replace only its
# build-signed preloaded-device store with the same store plus rng@1.0.
ENV HB_PRELOADED_STORE=/app/_build/preloaded-store
RUN rm -rf /app/_build/preloaded-store
COPY --from=preload /app/_build/preloaded-store /app/_build/preloaded-store
